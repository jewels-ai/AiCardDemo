      /* ---------- Theme & Language Controls ---------- */
      document.querySelector("#seasonSelect").addEventListener("change", (e) => {
        applySeason(e.target.value);
        showToast("Theme updated", "🎨");
      });
      document.querySelector("#modeToggleBtn").addEventListener("click", () => {
        const next = document.documentElement.getAttribute("data-mode") === "dark" ? "light" : "dark";
        applyMode(next);
        showToast(next === "light" ? "Milk Chocolate Mode" : "Dark Chocolate Mode", next === "light" ? "☀️" : "🌙");
      });
      function toggleLang() {
        applyLanguage(currentLang === "en" ? "ta" : "en");
        renderCatalog();
        positionChipSlider();
      }
      document.querySelector("#langToggleBtn").addEventListener("click", toggleLang);
      document.querySelector("#hudLangBtn").addEventListener("click", toggleLang);

      /* ---------- First-Time Onboarding Guide ---------- */
      const obModal = document.querySelector("#onboardingModal");
      const obTrack = document.querySelector("#obTrack");
      const obDots = document.querySelectorAll("#obDots .ob-dot");
      const obNext = document.querySelector("#obNext");
      let obStep = 0;

      function setObStep(step) {
        obStep = Math.max(0, Math.min(2, step));
        obTrack.style.transform = `translateX(-${obStep * 100}%)`;
        obDots.forEach((d, idx) => d.classList.toggle("active", idx === obStep));
        obNext.textContent = obStep === 2 ? t("start") : t("next");
      }
      function closeOnboarding() {
        obModal.classList.remove("show");
        localStorage.setItem("chocoai_onboarded", "1");
      }
      obNext.addEventListener("click", () => { if (obStep < 2) setObStep(obStep + 1); else closeOnboarding(); });
      document.querySelector("#obSkip").addEventListener("click", closeOnboarding);
      document.querySelector("#hudHelpBtn").addEventListener("click", () => { setObStep(0); obModal.classList.add("show"); });

      // Swipe support for onboarding
      let obTouchX = 0;
      document.querySelector("#obSwipeArea").addEventListener("touchstart", e => { obTouchX = e.touches[0].clientX; }, { passive: true });
      document.querySelector("#obSwipeArea").addEventListener("touchend", e => {
        const dx = e.changedTouches[0].clientX - obTouchX;
        if (dx < -40 && obStep < 2) setObStep(obStep + 1);
        else if (dx > 40 && obStep > 0) setObStep(obStep - 1);
      }, { passive: true });

      /* ---------- Camera Permission Helper ---------- */
      document.querySelector("#camRetryBtn").addEventListener("click", () => {
        document.querySelector("#cameraDeniedModal").classList.remove("show");
        startRawCameraFeed();
      });
      document.querySelector("#camCatalogBtn").addEventListener("click", () => {
        document.querySelector("#cameraDeniedModal").classList.remove("show");
        openCatalog();
      });

      /* ---------- Offline Detection ---------- */
      const offlineOverlay = document.querySelector("#offlineOverlay");
      function syncOnline() { offlineOverlay.classList.toggle("show", !navigator.onLine); }
      window.addEventListener("offline", syncOnline);
      window.addEventListener("online", () => {
        syncOnline();
        showToast("Back online!", "📡");
        if (!CATALOG_ITEMS.length) fetchDriveCatalog().then(() => { updateCounts(); renderCatalog(); });
      });
      document.querySelector("#offlineRetryBtn").addEventListener("click", () => {
        if (navigator.onLine) { offlineOverlay.classList.remove("show"); location.reload(); }
        else showToast("Still offline", "📡");
      });
      syncOnline();

      /* ---------- PWA Install Prompt ---------- */
      let deferredPrompt = null;
      const pwaBanner = document.querySelector("#pwaBanner");
      window.addEventListener("beforeinstallprompt", (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (!localStorage.getItem("chocoai_pwa_dismissed")) {
          setTimeout(() => pwaBanner.classList.add("show"), 2500);
        }
      });
      document.querySelector("#pwaInstallBtn").addEventListener("click", async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
        pwaBanner.classList.remove("show");
      });
      document.querySelector("#pwaDismissBtn").addEventListener("click", () => {
        pwaBanner.classList.remove("show");
        localStorage.setItem("chocoai_pwa_dismissed", "1");
      });

      /* ---------- Staged Loading Bar ---------- */
      const fillEl = document.querySelector("#chocoFill");
      const loaderText = document.querySelector("#loaderText");
      let progress = 0;
      function setStage(p, text) {
        if (p <= progress) return;
        progress = p;
        fillEl.style.width = p + "%";
        if (text) loaderText.textContent = text;
      }
      setStage(12, "Warming camera…");

      const uiKiller = setInterval(() => {
        document.querySelectorAll('[class^="mindar-ui"], [id^="mindar-ui"]').forEach(el => el.remove());
      }, 100);

      startRawCameraFeed().then(() => setStage(40, "Melting chocolate…"));

      /* ---------- Ripple + Tap Haptics ---------- */
      document.addEventListener("pointerdown", (e) => {
        const b = e.target.closest(".plan-button, .btn-gold, .btn-ghost, .close-btn, .category-chip, .modal-close, .icon-pill");
        if (!b) return;
        buzz(10);
        const r = b.getBoundingClientRect();
        const size = Math.max(r.width, r.height) * 2;
        const s = document.createElement("span");
        s.className = "ripple";
        s.style.width = s.style.height = size + "px";
        s.style.left = (e.clientX - r.left - size / 2) + "px";
        s.style.top = (e.clientY - r.top - size / 2) + "px";
        b.appendChild(s);
        setTimeout(() => s.remove(), 650);
      });

      /* ---------- Scroll Reveal, Parallax Hero, Sticky Shrink & Back-to-Top ---------- */
      const io = new IntersectionObserver((entries) => {
        entries.forEach(en => {
          if (!en.isIntersecting) return;
          const el = en.target;
          el.classList.add("in");
          setTimeout(() => { el.style.transitionDelay = ""; el.classList.add("done"); }, 900);
          io.unobserve(el);
        });
      }, { root: catalogSheet, threshold: 0.08, rootMargin: "0px 0px -24px 0px" });
      document.querySelectorAll(".reveal").forEach((el, i) => {
        el.style.transitionDelay = (i % 3) * 80 + "ms";
        io.observe(el);
      });

      const pShapes = document.querySelectorAll(".p-shape");
      let scrollTicking = false;
      catalogSheet.addEventListener("scroll", () => {
        if (scrollTicking) return;
        scrollTicking = true;
        requestAnimationFrame(() => {
          const y = catalogSheet.scrollTop;
          siteNav.classList.toggle("scrolled", y > 36);
          backToTop.classList.toggle("show", y > 360);
          if (!REDUCED && y < 600) {
            pShapes.forEach(sh => {
              const spd = parseFloat(sh.dataset.speed || 0.2);
              sh.style.transform = `translateY(${y * spd}px) rotate(${18 + y * 0.05}deg)`;
            });
          }
          scrollTicking = false;
        });
      }, { passive: true });
      backToTop.addEventListener("click", () => catalogSheet.scrollTo({ top: 0, behavior: "smooth" }));

      /* ---------- Count-up Stats ---------- */
      function countUp(el, to, dur = 1200) {
        if (REDUCED || !to) { el.textContent = to; return; }
        const t0 = performance.now();
        (function step(ts) {
          const p = Math.min((ts - t0) / dur, 1);
          el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(step);
        })(t0);
      }
      function runStats() {
        if (CATALOG_ITEMS.length) countUp(document.querySelector("#statTotal"), CATALOG_ITEMS.length);
        countUp(document.querySelector("#statCat"), Object.keys(CATALOG_FOLDERS).length, 850);
      }

      /* ---------- Video Auto-Crop & Play Progress Ring ---------- */
      videoEl.addEventListener("loadedmetadata", () => {
        if (!videoPlane) return;
        const vw = videoEl.videoWidth, vh = videoEl.videoHeight;
        if (vw === 0 || vh === 0) return;
        const aspectRatio = vw / vh;
        if (aspectRatio > 1) {
          const repeatX = 1 / aspectRatio;
          videoPlane.setAttribute("material", `repeat: ${repeatX} 1; offset: ${(1 - repeatX) / 2} 0`);
        } else {
          const repeatY = aspectRatio;
          videoPlane.setAttribute("material", `repeat: 1 ${repeatY}; offset: 0 ${(1 - repeatY) / 2}`);
        }
      });

      const RING_CIRC = 2 * Math.PI * 28; // ~175.9
      videoEl.addEventListener("timeupdate", () => {
        if (!videoEl.duration) return;
        const pct = videoEl.currentTime / videoEl.duration;
        playRingFg.style.strokeDashoffset = (RING_CIRC * (1 - pct)).toFixed(2);
      });

      /* ---------- Category Chip Gold Slider ---------- */
      function positionChipSlider() {
        const activeBtn = document.querySelector(".category-chip.active");
        if (!activeBtn || !chipSlider) return;
        chipSlider.style.width = activeBtn.offsetWidth + "px";
        chipSlider.style.transform = `translateX(${activeBtn.offsetLeft}px)`;
        chipSlider.classList.toggle("fav-mode", activeBtn.dataset.cat === "fav");
      }
      window.addEventListener("resize", positionChipSlider);

      /* ---------- View Toggle (Grid / List) ---------- */
      document.querySelector("#viewToggleBtn").addEventListener("click", (e) => {
        const isList = catalogList.classList.toggle("list-view");
        e.currentTarget.textContent = isList ? "⊞" : "☰";
        showToast(isList ? "List View" : "Grid View", isList ? "☰" : "⊞");
      });

      /* ---------- Recently Viewed Rendering ---------- */
      function renderRecent() {
        const sec = document.querySelector("#recentSection");
        const row = document.querySelector("#recentRow");
        const items = RECENT.map(id => CATALOG_ITEMS.find(x => x.id === id)).filter(Boolean);
        sec.classList.toggle("has-items", items.length > 0);
        if (!items.length) return;
        row.innerHTML = items.map(it => `
          <div class="recent-chip" data-rid="${it.id}">
            <img src="${it.img}" alt="${escapeHTML(it.name)}" referrerpolicy="no-referrer" />
            <span>${escapeHTML(it.name)}</span>
          </div>`).join("");
        row.querySelectorAll(".recent-chip").forEach(ch => {
          ch.addEventListener("click", () => {
            const found = CATALOG_ITEMS.find(x => x.id === ch.dataset.rid);
            if (found) openProduct(found);
          });
        });
      }

      /* ---------- Catalog Rendering + Highlight + Tilt + Long-Press Quick View ---------- */
      function showSkeletons() {
        catalogList.innerHTML = Array.from({ length: 8 }).map(() => `
          <div class="catalog-card skeleton">
            <div class="thumb-wrap"></div>
            <div class="card-body"><div class="line" style="width:80%"></div><div class="line" style="width:40%"></div></div>
          </div>`).join("");
      }

      function updateCounts() {
        const counts = { all: CATALOG_ITEMS.length };
        Object.keys(CATALOG_FOLDERS).forEach(k => counts[k] = 0);
        CATALOG_ITEMS.forEach(i => { if (counts[i.category] !== undefined) counts[i.category]++; });
        Object.entries(counts).forEach(([k, v]) => {
          const el = document.querySelector("#cnt-" + k);
          if (el) el.textContent = v;
        });
        if (!catalogSheet.classList.contains("open")) document.querySelector("#statTotal").textContent = counts.all;
        updateFavCount();
      }

      function updateFavCount() {
        const n = CATALOG_ITEMS.filter(i => FAVS.has(i.id)).length;
        document.querySelector("#cnt-fav").textContent = n;
      }

      function highlightMatch(text, query) {
        const safe = escapeHTML(text);
        if (!query) return safe;
        const re = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "ig");
        return safe.replace(re, '<mark class="hl">$1</mark>');
      }

      function getVisibleItems() {
        let list;
        if (activeCat === "all") list = [...CATALOG_ITEMS];
        else if (activeCat === "fav") list = CATALOG_ITEMS.filter(i => FAVS.has(i.id));
        else list = CATALOG_ITEMS.filter(i => i.category === activeCat);
        if (searchTerm) {
          const q = searchTerm.toLowerCase();
          list = list.filter(i => i.name.toLowerCase().includes(q) || i.categoryLabel.toLowerCase().includes(q));
        }
        if (sortMode === "az") list.sort((a, b) => a.name.localeCompare(b.name));
        else if (sortMode === "za") list.sort((a, b) => b.name.localeCompare(a.name));
        else list.sort((a, b) => (b.isNew ? 1 : 0) - (a.isNew ? 1 : 0));
        return list;
      }

      const quickViewOverlay = document.querySelector("#quickViewOverlay");
      quickViewOverlay.addEventListener("click", () => quickViewOverlay.classList.remove("show"));

      function renderCatalog(withFade = false) {
        if (withFade) catalogList.classList.add("fading");
        const draw = () => {
          const items = getVisibleItems();
          catalogList.innerHTML = "";
          resultLine.textContent = items.length ? `${items.length} ${t("treats")}` : "";

          if (items.length === 0) {
            catalogList.innerHTML = `
              <div class="catalog-empty">
                <svg class="sad-choco-svg" viewBox="0 0 120 120" fill="none">
                  <path d="M26 22 H74 C76 34 86 42 96 42 V98 C96 104 91 108 85 108 H35 C29 108 26 104 26 98 Z" fill="#5C2E14" stroke="#D4AF37" stroke-width="3"/>
                  <line x1="26" y1="54" x2="96" y2="54" stroke="#D4AF37" stroke-opacity="0.4" stroke-width="2"/>
                  <line x1="60" y1="22" x2="60" y2="108" stroke="#D4AF37" stroke-opacity="0.4" stroke-width="2"/>
                  <circle cx="46" cy="70" r="4" fill="#F5EFE6"/><circle cx="74" cy="70" r="4" fill="#F5EFE6"/>
                  <path d="M48 88 Q60 78 72 88" stroke="#F0D687" stroke-width="3" stroke-linecap="round" fill="none"/>
                </svg>
                <div>${activeCat === "fav" ? t("emptyFav") : t("emptySearch")}</div>
              </div>`;
            catalogList.classList.remove("fading");
            return;
          }

          const isDesktop = window.matchMedia("(pointer: fine)").matches;

          items.forEach((item, i) => {
            const card = document.createElement("div");
            card.className = "catalog-card reveal";
            card.style.transitionDelay = Math.min((i % 8) * 60, 420) + "ms";
            card.innerHTML = `
              <div class="thumb-wrap">
                <span class="badge">${escapeHTML(item.categoryLabel)}</span>
                ${item.isNew ? '<span class="badge new">New</span>' : ""}
                <button class="heart ${FAVS.has(item.id) ? "on" : ""}" data-id="${item.id}" aria-label="Save to favourites">${FAVS.has(item.id) ? "♥" : "♡"}</button>
                <img src="${item.img}" alt="${escapeHTML(item.name)}" loading="lazy" referrerpolicy="no-referrer" />
              </div>
              <div class="card-body">
                <div class="name">${highlightMatch(item.name, searchTerm)}</div>
                <div class="view">${t("viewDetails")}</div>
              </div>`;

            // Blur-up image sharp reveal
            const imgEl = card.querySelector("img");
            if (imgEl.complete) imgEl.classList.add("loaded");
            else imgEl.addEventListener("load", () => imgEl.classList.add("loaded"));

            // Desktop 3D tilt effect
            if (isDesktop && !REDUCED) {
              card.addEventListener("mousemove", (e) => {
                const r = card.getBoundingClientRect();
                const rx = ((e.clientY - r.top) / r.height - 0.5) * -9;
                const ry = ((e.clientX - r.left) / r.width - 0.5) * 9;
                card.style.transform = `perspective(700px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-4px)`;
              });
              card.addEventListener("mouseleave", () => { card.style.transform = ""; });
            }

            // Long-press quick view
            let lpTimer = null, didLongPress = false;
            card.addEventListener("touchstart", () => {
              didLongPress = false;
              lpTimer = setTimeout(() => {
                didLongPress = true;
                buzz(20);
                document.querySelector("#qvImg").src = item.imgLarge;
                document.querySelector("#qvTitle").textContent = item.name;
                quickViewOverlay.classList.add("show");
              }, 480);
            }, { passive: true });
            card.addEventListener("touchend", () => clearTimeout(lpTimer), { passive: true });
            card.addEventListener("touchmove", () => clearTimeout(lpTimer), { passive: true });

            card.addEventListener("click", () => { if (!didLongPress) openProduct(item); });
            card.querySelector(".heart").addEventListener("click", (e) => {
              e.stopPropagation();
              toggleFav(item.id, e.currentTarget, e.clientX, e.clientY);
            });
            catalogList.appendChild(card);
            io.observe(card);
          });
          catalogList.classList.remove("fading");
        };
        if (withFade) setTimeout(draw, 140); else draw();
      }

      /* ---------- Favourites + Gold Confetti ---------- */
      function burstHeart(btn) {
        for (let i = 0; i < 8; i++) {
          const p = document.createElement("span");
          p.className = "burst-p";
          const ang = (Math.PI * 2 * i) / 8, dist = 26 + Math.random() * 10;
          p.style.setProperty("--dx", Math.cos(ang) * dist + "px");
          p.style.setProperty("--dy", Math.sin(ang) * dist + "px");
          btn.appendChild(p);
          setTimeout(() => p.remove(), 650);
        }
      }

      function syncHearts() {
        document.querySelectorAll(".heart[data-id]").forEach(h => {
          const on = FAVS.has(h.dataset.id);
          h.classList.toggle("on", on);
          h.textContent = on ? "♥" : "♡";
        });
        if (currentProduct) {
          const on = FAVS.has(currentProduct.id);
          modalFav.classList.toggle("on", on);
          modalFav.textContent = on ? "♥ Saved" : "♡ Save";
        }
      }

      function toggleFav(id, heartBtn, cx, cy) {
        const adding = !FAVS.has(id);
        if (adding) FAVS.add(id); else FAVS.delete(id);
        saveFavs();
        updateFavCount();
        buzz(adding ? [15, 30, 15] : 10);
        showToast(adding ? "Saved to favourites" : "Removed from favourites", adding ? "♥" : "♡");
        if (adding) spawnConfetti(cx, cy);
        if (activeCat === "fav" && !adding) { renderCatalog(true); syncHearts(); return; }
        syncHearts();
        if (adding && heartBtn) {
          heartBtn.classList.remove("pop"); void heartBtn.offsetWidth; heartBtn.classList.add("pop");
          burstHeart(heartBtn);
        }
      }

      function setCategory(cat, scrollToGrid) {
        activeCat = cat;
        categoryTabs.forEach(c => c.classList.toggle("active", c.dataset.cat === cat));
        positionChipSlider();
        renderCatalog(true);
        if (scrollToGrid) scrollToSection("catCollection");
      }

      function scrollToSection(id) {
        const el = document.getElementById(id);
        if (el) catalogSheet.scrollTo({ top: el.offsetTop - 64, behavior: "smooth" });
      }

      /* ---------- Product Modal: Gallery, Pinch-Zoom, Share, Related ---------- */
      let imgScale = 1, pinchStartDist = 0, lastTap = 0;
      function resetZoom() { imgScale = 1; modalImg.style.transform = ""; }

      function setGalleryIndex(idx) {
        if (!currentProduct) return;
        const g = currentProduct.gallery;
        galleryIdx = (idx + g.length) % g.length;
        modalImg.src = g[galleryIdx];
        resetZoom();
        galleryDots.querySelectorAll(".gallery-dot").forEach((d, i) => d.classList.toggle("active", i === galleryIdx));
      }

      function openProduct(item) {
        currentProduct = item;
        galleryIdx = 0;
        addRecent(item.id);
        renderRecent();

        modalCard.style.transform = "";
        resetZoom();
        modalImg.src = item.gallery[0];
        modalImg.alt = item.name;
        modalName.textContent = item.name;
        modalCat.textContent = item.categoryLabel + (item.isNew ? " · New" : "");

        // Gallery dots
        if (item.gallery.length > 1) {
          galleryDots.style.display = "flex";
          galleryDots.innerHTML = item.gallery.map((_, i) => `<span class="gallery-dot ${i === 0 ? "active" : ""}" data-gi="${i}"></span>`).join("");
          galleryDots.querySelectorAll(".gallery-dot").forEach(d => d.addEventListener("click", () => setGalleryIndex(Number(d.dataset.gi))));
        } else {
          galleryDots.style.display = "none";
        }

        // Related treats
        const related = CATALOG_ITEMS.filter(x => x.category === item.category && x.id !== item.id).slice(0, 6);
        const relWrap = document.querySelector("#modalRelatedWrap");
        const relStrip = document.querySelector("#modalRelated");
        if (related.length) {
          relWrap.style.display = "block";
          relStrip.innerHTML = related.map(r => `
            <div class="rel-card" data-rel="${r.id}">
              <img src="${r.img}" alt="${escapeHTML(r.name)}" referrerpolicy="no-referrer" />
              <span>${escapeHTML(r.name)}</span>
            </div>`).join("");
          relStrip.querySelectorAll(".rel-card").forEach(rc => {
            rc.addEventListener("click", () => {
              const targetItem = CATALOG_ITEMS.find(x => x.id === rc.dataset.rel);
              if (targetItem) openProduct(targetItem);
            });
          });
        } else {
          relWrap.style.display = "none";
        }

        productModal.classList.add("show");
        productModal.setAttribute("aria-hidden", "false");
        modalCard.scrollTop = 0;
        syncHearts();
      }

      function closeProduct() {
        productModal.classList.remove("show");
        productModal.setAttribute("aria-hidden", "true");
        resetZoom();
        setTimeout(() => { modalCard.style.transform = ""; productModal.style.background = ""; }, 400);
      }

      // Pinch-to-zoom, Double-tap zoom & Horizontal Gallery Swipe
      let galSwipeX = 0;
      modalImgWrap.addEventListener("touchstart", (e) => {
        if (e.touches.length === 2) {
          pinchStartDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
        } else if (e.touches.length === 1) {
          galSwipeX = e.touches[0].clientX;
          const now = Date.now();
          if (now - lastTap < 280) {
            imgScale = imgScale > 1 ? 1 : 2.1;
            modalImg.style.transform = `scale(${imgScale})`;
          }
          lastTap = now;
        }
      }, { passive: true });

      modalImgWrap.addEventListener("touchmove", (e) => {
        if (e.touches.length === 2 && pinchStartDist > 0) {
          const dist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          imgScale = Math.max(1, Math.min(3, (dist / pinchStartDist) * imgScale));
          pinchStartDist = dist;
          modalImg.style.transform = `scale(${imgScale.toFixed(2)})`;
        }
      }, { passive: true });

      modalImgWrap.addEventListener("touchend", (e) => {
        if (e.touches.length < 2) pinchStartDist = 0;
        if (imgScale <= 1.05 && currentProduct && currentProduct.gallery.length > 1 && e.changedTouches.length === 1) {
          const dx = e.changedTouches[0].clientX - galSwipeX;
          if (Math.abs(dx) > 45) setGalleryIndex(galleryIdx + (dx < 0 ? 1 : -1));
        }
      }, { passive: true });

      document.querySelector("#modalClose").addEventListener("click", closeProduct);
      productModal.addEventListener("click", (e) => { if (e.target === productModal) closeProduct(); });
      modalFav.addEventListener("click", (e) => {
        if (!currentProduct) return;
        const gridHeart = catalogList.querySelector(`.heart[data-id="${currentProduct.id}"]`);
        toggleFav(currentProduct.id, gridHeart, e.clientX, e.clientY);
        if (FAVS.has(currentProduct.id)) burstHeart(modalFav);
      });

      // Web Share API
      document.querySelector("#modalShare").addEventListener("click", async () => {
        if (!currentProduct) return;
        const shareData = {
          title: `CHOCO·AI — ${currentProduct.name}`,
          text: `Check out "${currentProduct.name}" (${currentProduct.categoryLabel}) on CHOCO·AI!`,
          url: location.href
        };
        try {
          if (navigator.share) {
            await navigator.share(shareData);
          } else if (navigator.clipboard) {
            await navigator.clipboard.writeText(`${shareData.text} ${shareData.url}`);
            showToast("Link copied to clipboard", "📋");
          }
        } catch (e) {}
      });

      // Enquire + Confetti + WhatsApp
      document.querySelector("#modalEnquire").addEventListener("click", (e) => {
        if (WHATSAPP_NUMBER && currentProduct) {
          buzz([20, 40, 20]);
          spawnConfetti(e.clientX, e.clientY);
          showToast("Opening WhatsApp…", "💬");
          const msg = encodeURIComponent(`Hi, I'm interested in "${currentProduct.name}" (${currentProduct.categoryLabel}).`);
          setTimeout(() => window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${msg}`, "_blank", "noopener"), 280);
        } else {
          closeProduct();
        }
      });

      // Swipe-down to close modal (disabled while zoomed)
      let swipeStartY = 0, swipeDY = 0, swiping = false;
      modalCard.addEventListener("touchstart", (e) => {
        if (modalCard.scrollTop > 0 || imgScale > 1.05 || e.touches.length > 1) { swiping = false; return; }
        swipeStartY = e.touches[0].clientY; swipeDY = 0; swiping = true;
      }, { passive: true });
      modalCard.addEventListener("touchmove", (e) => {
        if (!swiping) return;
        swipeDY = e.touches[0].clientY - swipeStartY;
        if (swipeDY <= 0) { swipeDY = 0; return; }
        modalCard.style.transition = "none";
        modalCard.style.transform = `translateY(${swipeDY}px) scale(${1 - Math.min(swipeDY / 1800, 0.05)})`;
      }, { passive: true });
      modalCard.addEventListener("touchend", () => {
        if (!swiping) return;
        swiping = false;
        modalCard.style.transition = "";
        if (swipeDY > 110) { buzz(15); closeProduct(); }
        else { modalCard.style.transform = ""; }
        swipeDY = 0;
      });

      /* ---------- Search Suggestions & Controls ---------- */
      function renderSuggestions(val) {
        const q = val.trim().toLowerCase();
        const boxes = [suggDesktop, suggMobile];
        if (!q || !CATALOG_ITEMS.length) { boxes.forEach(b => b.classList.remove("show")); return; }
        const matches = CATALOG_ITEMS.filter(i => i.name.toLowerCase().includes(q)).slice(0, 5);
        if (!matches.length) { boxes.forEach(b => b.classList.remove("show")); return; }
        const html = matches.map(m => `<div class="sugg-item" data-sid="${m.id}"><span>${highlightMatch(m.name, q)}</span><small>${escapeHTML(m.categoryLabel)}</small></div>`).join("");
        boxes.forEach(b => {
          b.innerHTML = html;
          b.classList.add("show");
          b.querySelectorAll(".sugg-item").forEach(si => {
            si.addEventListener("click", () => {
              const item = CATALOG_ITEMS.find(x => x.id === si.dataset.sid);
              boxes.forEach(bx => bx.classList.remove("show"));
              if (item) openProduct(item);
            });
          });
        });
      }

      function onSearch(value) {
        searchTerm = value.trim();
        searchInput.value = value;
        searchInputMobile.value = value;
        renderSuggestions(value);
        renderCatalog();
      }
      searchInput.addEventListener("input", e => onSearch(e.target.value));
      searchInputMobile.addEventListener("input", e => onSearch(e.target.value));
      document.addEventListener("click", (e) => {
        if (!e.target.closest(".nav-search, .mobile-search")) {
          suggDesktop.classList.remove("show"); suggMobile.classList.remove("show");
        }
      });

      document.querySelectorAll("[data-scroll]").forEach(a => {
        a.addEventListener("click", () => {
          const map = { top: "catTop", collection: "catCollection", promise: "catPromise", contact: "catContact" };
          if (a.dataset.scroll === "top") catalogSheet.scrollTo({ top: 0, behavior: "smooth" });
          else scrollToSection(map[a.dataset.scroll]);
        });
      });
      document.querySelectorAll("[data-cat-link]").forEach(a => a.addEventListener("click", () => setCategory(a.dataset.catLink, true)));
      document.querySelector("#heroBrowse").addEventListener("click", () => scrollToSection("catCollection"));
      document.querySelector("#heroPremium").addEventListener("click", () => setCategory("premium", true));
      categoryTabs.forEach(chip => chip.addEventListener("click", () => setCategory(chip.dataset.cat, false)));
      sortSelect.addEventListener("change", e => { sortMode = e.target.value; renderCatalog(true); });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          if (productModal.classList.contains("show")) closeProduct();
          else if (catalogSheet.classList.contains("open")) closeCatalog();
        }
      });

      /* ---------- AR Camera Pause/Resume & Melt Drip Transition ---------- */
      let arRunning = true, arBusy = false;
      function getArSystem() { return sceneEl.systems && sceneEl.systems["mindar-image-system"]; }

      async function pauseCamera() {
        stopRawCameraFeed();
        if (arBusy || !arRunning) return;
        const arSystem = getArSystem();
        if (!arSystem || !arSystem.video) return;
        arBusy = true;
        try {
          arSystem.stop();
          document.querySelectorAll("video").forEach(v => {
            const s = v.srcObject;
            if (s && s.getTracks) s.getTracks().forEach(tr => tr.stop());
          });
          arRunning = false;
        } catch (err) {}
        arBusy = false;
      }

      async function resumeCamera() {
        if (arBusy || arRunning) return;
        const arSystem = getArSystem();
        if (!arSystem) return;
        arBusy = true;
        try { await arSystem.start(); arRunning = true; } catch (err) {}
        arBusy = false;
        startRawCameraFeed();
      }

      function openCatalog() {
        if (catalogTransitioning) return;
        catalogTransitioning = true;
        arInfoBubble.classList.remove("show");
        if (videoEl && !videoEl.paused) videoEl.pause();
        isPlaying = false;
        toggleButton.textContent = "▶";

        // Trigger chocolate melt drip transition
        if (!REDUCED) {
          meltEl.classList.remove("clearing");
          meltEl.classList.add("dripping");
        }
        setTimeout(() => {
          document.body.classList.add("catalog-open");
          catalogSheet.classList.add("open");
          catalogSheet.scrollTop = 0;
          runStats();
          renderRecent();
          setTimeout(positionChipSlider, 80);
          pauseCamera();
          if (!REDUCED) {
            meltEl.classList.remove("dripping");
            meltEl.classList.add("clearing");
            setTimeout(() => meltEl.classList.remove("clearing"), 720);
          }
          setTimeout(() => { catalogTransitioning = false; }, 250);
        }, REDUCED ? 0 : 280);
      }

      function closeCatalog() {
        if (catalogTransitioning || !catalogSheet.classList.contains("open")) return;
        catalogTransitioning = true;
        closeProduct();
        catalogSheet.classList.remove("open");
        document.body.classList.remove("catalog-open");
        resumeCamera();
        setTimeout(() => { catalogTransitioning = false; }, 300);
      }

      openCatalogBtn.addEventListener("click", openCatalog);
      closeCatalogBtn.addEventListener("click", closeCatalog);

      /* ---------- Curtain Dismissal & First-Time Onboarding Trigger ---------- */
      let curtainDismissed = false;
      function dismissCurtainOnce() {
        if (curtainDismissed) return;
        curtainDismissed = true;
        setStage(100, "Ready!");
        setTimeout(() => {
          curtain.style.opacity = "0";
          setTimeout(() => {
            curtain.style.display = "none";
            clearInterval(uiKiller);
            if (!localStorage.getItem("chocoai_onboarded")) {
              setObStep(0);
              obModal.classList.add("show");
            }
          }, 600);
        }, 550);
      }

      sceneEl.addEventListener("arReady", dismissCurtainOnce);
      sceneEl.addEventListener("arError", (err) => {
        console.error("MindAR failed:", err);
        dismissCurtainOnce();
      });

      const curtainWatcher = setInterval(() => {
        const camFeed = document.querySelector("video.mindar-camera, video[autoplay]");
        if (camFeed && camFeed.readyState >= 2 && !camFeed.paused) {
          setStage(70, "Almost there…");
          dismissCurtainOnce();
          clearInterval(curtainWatcher);
        }
      }, 300);
      setTimeout(() => { clearInterval(curtainWatcher); dismissCurtainOnce(); }, 6000);

      /* ---------- TARGET FOUND (POP-IN + FOIL UNWRAP + SNAP SOUND) ---------- */
      function showVideoGroup(withPop) {
        videoGroup.object3D.visible = true;
        videoGroup.setAttribute("visible", "true");
        if (withPop) {
          // Reset golden wrapper halves before peeling
          wrapperLeft.setAttribute("position", "-0.25 0 0.012");
          wrapperLeft.setAttribute("rotation", "0 0 0");
          wrapperLeft.setAttribute("material", "opacity: 1");
          wrapperRight.setAttribute("position", "0.25 0 0.012");
          wrapperRight.setAttribute("rotation", "0 0 0");
          wrapperRight.setAttribute("material", "opacity: 1");

          videoGroup.emit("popin");
          wrapperLeft.emit("unwrap");
          wrapperRight.emit("unwrap");
        }
      }

      target.addEventListener("targetFound", async () => {
        hasFoundOnce = true;
        clearTimeout(lostTimer);
        lostHint.classList.remove("show");
        document.body.classList.add("found");
        buzz([30, 50, 30]);
        playChocoSnap();

        target.object3D.visible = true;
        target.setAttribute("visible", "true");
        showVideoGroup(true);

        if (!currentLoadedFileId) {
          const fileId = await getLatestVideoId();
          if (fileId) {
            currentLoadedFileId = fileId;
            videoEl.src = `https://www.googleapis.com/drive/v3/files/${fileId}?alt=media&key=${API_KEY}`;
            videoEl.load();
          }
        }
        isPlaying = false;
        toggleButton.textContent = "▶";
      });

      /* ---------- TARGET LOST (2-SECOND CUSTOM HINT) ---------- */
      target.addEventListener("targetLost", () => {
        document.body.classList.remove("found");
        arInfoBubble.classList.remove("show");
        closeCatalog();

        if (!videoEl.paused) videoEl.pause();
        target.object3D.visible = false;
        target.setAttribute("visible", "false");
        videoGroup.object3D.visible = false;
        videoGroup.setAttribute("visible", "false");
        videoGroup.object3D.scale.set(0.001, 0.001, 0.001);

        isPlaying = false;
        toggleButton.textContent = "▶";

        if (hasFoundOnce) {
          clearTimeout(lostTimer);
          lostTimer = setTimeout(() => {
            if (!document.body.classList.contains("found") && !document.body.classList.contains("catalog-open")) {
              lostHint.classList.add("show");
            }
          }, 2000);
        }
      });

      /* ---------- PLAY / PAUSE ---------- */
      toggleButton.addEventListener("click", async () => {
        try {
          if (!isPlaying) {
            videoEl.muted = false;
            await videoEl.play();
            toggleButton.textContent = "⏸";
            isPlaying = true;
            target.object3D.visible = true;
            target.setAttribute("visible", "true");
            showVideoGroup(false);
          } else {
            videoEl.pause();
            toggleButton.textContent = "▶";
            isPlaying = false;
          }
        } catch (err) {
          console.error("Playback error:", err);
        }
      });

      /* ---------- Initial Catalog Load ---------- */
      showSkeletons();
      fetchDriveCatalog().then(() => {
        setStage(60, "Melting chocolate…");
        updateCounts();
        renderCatalog(true);
        renderRecent();
        if (catalogSheet.classList.contains("open")) {
          runStats();
          setTimeout(positionChipSlider, 80);
        }
      });
    });

    /* ======================================================
       UPGRADED TOAST & ANTI-TAMPER DETERRENTS
    ====================================================== */
    let toastTimer = null;
    function showToast(message, icon = "✨") {
      const toast = document.querySelector("#toast");
      if (!toast) return;
      document.querySelector("#toastIcon").textContent = icon;
      document.querySelector("#toastMsg").textContent = message;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("show"), 2000);
    }

    document.addEventListener("keydown", (e) => {
      const isCmdOrCtrl = e.ctrlKey || e.metaKey;
      const key = e.key ? e.key.toUpperCase() : "";
      if (
        e.key === "F12" ||
        (isCmdOrCtrl && e.shiftKey && (key === "I" || key === "J" || key === "C")) ||
        (isCmdOrCtrl && key === "U")
      ) {
        e.preventDefault();
        showToast("Action Disabled", "🔒");
      }
    });

    document.addEventListener("contextmenu", (e) => {
      e.preventDefault();
      showToast("Action Disabled", "🔒");
    });
  </script>
</body>
</html>