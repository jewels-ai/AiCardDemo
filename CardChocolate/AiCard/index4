          p.setAttribute("animation", `property: position; from: ${x} ${y} ${z}; to: ${x} ${dy} ${z}; dir: alternate; dur: ${1800 + i * 210}; easing: easeInOutSine; loop: true`);
          particleRoot.appendChild(p);
