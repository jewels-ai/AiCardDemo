    async function startRawCameraFeed() {
      if (rawStream || rawStarting) return;
      const rawFeed = document.querySelector("#rawCameraFeed");
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) return;
      rawStarting = true;
      try {
        let stream;
        try {
          stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: "environment" } }, audio: false });
        } catch (envErr) {
          if (envErr && (envErr.name === "NotAllowedError" || envErr.name === "PermissionDeniedError")) throw envErr;
          stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        }
        rawStream = stream;
        rawFeed.srcObject = stream;
        await rawFeed.play();
        document.querySelector("#cameraDeniedModal").classList.remove("show");
      } catch (anyErr) {
        console.error("Camera access failed:", anyErr);
        if (anyErr && (anyErr.name === "NotAllowedError" || anyErr.name === "PermissionDeniedError")) {
          document.querySelector("#cameraDeniedModal").classList.add("show");
