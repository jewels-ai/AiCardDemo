<!DOCTYPE html>
<html lang="en" data-mode="dark" data-season="default">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#1a0f0a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>CHOCO-AI | Live Drive AR</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600;700&family=Noto+Sans+Tamil:wght@400;600;700&display=swap" rel="stylesheet">

  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

  <style>
    :root {
      --deep: #1a0f0a;
      --deep-2: #2a1810;
      --brand-accent: #6b3a1f;
      --brand-accent-dark: #3a1d0e;
      --gold: #D4AF37;
      --gold-soft: #F0D687;
      --cream: #F5EFE6;
      --cream-dim: rgba(245, 239, 230, 0.66);
      --glass: rgba(245, 239, 230, 0.08);
      --glass-strong: rgba(26, 15, 10, 0.86);
      --glass-border: rgba(212, 175, 55, 0.35);
      --card-bg: rgba(255, 255, 255, 0.045);
      --heart: #ff5a6e;
      --nav-bg: rgba(26, 15, 10, 0.82);
      --modal-backdrop: rgba(12, 6, 3, 0.82);
    }

    /* ---------- Milk Chocolate Light Theme ---------- */
    [data-mode="light"] {
      --deep: #FAF3E8;
      --deep-2: #EFE2CE;
      --brand-accent: #7A4424;
      --brand-accent-dark: #4E2710;
      --gold: #B0851A;
      --gold-soft: #8A640D;
      --cream: #2B170B;
      --cream-dim: rgba(43, 23, 11, 0.68);
      --glass: rgba(78, 39, 16, 0.07);
      --glass-strong: rgba(250, 243, 232, 0.92);
      --glass-border: rgba(176, 133, 26, 0.38);
      --card-bg: rgba(255, 255, 255, 0.72);
      --nav-bg: rgba(250, 243, 232, 0.88);
      --modal-backdrop: rgba(43, 23, 11, 0.58);
    }

    /* ---------- Seasonal Accent Themes ---------- */
    [data-season="diwali"] {
      --gold: #FFB703;
      --gold-soft: #FFD166;
      --brand-accent: #9E2A2B;
      --brand-accent-dark: #540B0E;
    }
    [data-season="christmas"] {
      --gold: #E0B84C;
      --gold-soft: #F7DC88;
      --brand-accent: #1B5E3A;
      --brand-accent-dark: #0E3822;
      --heart: #D62828;
    }
    [data-season="valentine"] {
      --gold: #F4A6B8;
      --gold-soft: #FFD1DC;
      --brand-accent: #8E1B3A;
      --brand-accent-dark: #4A0D1E;
      --heart: #FF3366;
    }
    [data-season="pongal"] {
      --gold: #E9A825;
      --gold-soft: #F9D469;
      --brand-accent: #B85D19;
      --brand-accent-dark: #6E330B;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0; background: #1a0f0a; overflow: hidden;
      font-family: 'Manrope', 'Noto Sans Tamil', sans-serif; color: var(--cream);
      -webkit-tap-highlight-color: transparent; height: 100%;
    }

    body.catalog-open a-scene,
    body.catalog-open #rawCameraFeed {
      filter: brightness(0.25) saturate(0.7) blur(10px);
      transition: filter 0.6s ease; pointer-events: none;
    }
    a-scene { transition: filter 0.4s ease; }

    #rawCameraFeed {
      position: fixed; inset: 0; width: 100%; height: 100%;
      object-fit: cover; z-index: 0; background: #000; transition: filter 0.4s ease;
    }

    /* ---------- Loading Curtain ---------- */
    #blackCurtain {
      position: fixed; inset: 0;
      background: radial-gradient(circle at 50% 40%, #2a1810 0%, #1a0f0a 70%);
      z-index: 99999; display: flex; flex-direction: column; justify-content: center; align-items: center;
      gap: 22px; transition: opacity 0.6s ease; pointer-events: none;
    }
    .choco-bar {
      position: relative; width: min(70vw, 260px); height: 36px; border-radius: 8px;
      border: 1.5px solid #D4AF37; overflow: hidden; background: rgba(255,255,255,0.05);
      box-shadow: 0 0 18px rgba(212,175,55,0.2);
    }
    .choco-fill {
      position: absolute; inset: 0 auto 0 0; width: 0%;
      background: linear-gradient(180deg, #8a5230 0%, #3a1d0e 100%);
      border-right: 2px solid #F0D687;
      transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .choco-fill::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(115deg, transparent 30%, rgba(240,214,135,0.35) 50%, transparent 70%);
      background-size: 200% 100%; animation: shimmer 1.6s linear infinite;
    }
    .choco-bar::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background:
        repeating-linear-gradient(90deg, transparent 0 calc(25% - 1px), rgba(212,175,55,0.5) calc(25% - 1px) 25%),
        linear-gradient(180deg, transparent 48%, rgba(212,175,55,0.4) 48% 52%, transparent 52%);
    }
    #loader {
      font-family: 'Cormorant Garamond', 'Noto Sans Tamil', serif; font-weight: 500; font-style: italic;
      font-size: 19px; letter-spacing: 2px; color: #F5EFE6; text-align: center;
      animation: pulse 1.8s ease-in-out infinite;
    }
    #loader span {
      display: block; font-family: 'Manrope', sans-serif; font-style: normal;
      font-size: 10px; letter-spacing: 4px; text-transform: uppercase;
      color: #F0D687; margin-top: 6px;
    }
    @keyframes pulse { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }

    /* ---------- AR HUD ---------- */
    #brandMark {
      position: fixed; top: max(18px, env(safe-area-inset-top)); left: 50%;
      transform: translateX(-50%); z-index: 500; display: flex; align-items: center; gap: 8px; padding: 8px 16px;
      background: rgba(26, 15, 10, 0.65); border: 1px solid rgba(212,175,55,0.35); border-radius: 999px;
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: 15px;
      letter-spacing: 3px; color: #F0D687; pointer-events: none; transition: opacity 0.4s ease;
    }
    #brandMark::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #D4AF37; box-shadow: 0 0 8px #D4AF37; }

    #hudTopRight {
      position: fixed; top: max(16px, env(safe-area-inset-top)); right: 16px;
      z-index: 600; display: flex; gap: 8px; transition: opacity 0.3s ease;
    }
    body.catalog-open #hudTopRight { opacity: 0; pointer-events: none; }
    .hud-icon-btn {
      width: 38px; height: 38px; border-radius: 50%; border: 1px solid rgba(212,175,55,0.4);
      background: rgba(26, 15, 10, 0.72); color: #F0D687; font-size: 15px; cursor: pointer;
      display: grid; place-items: center; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      transition: transform 0.15s ease, background 0.2s ease;
    }
    .hud-icon-btn:active { transform: scale(0.92); }
    .hud-icon-btn.muted { opacity: 0.55; }

    #scanHint {
      position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
      z-index: 400; width: min(64vw, 260px); aspect-ratio: 1;
      transition: opacity 0.4s ease, transform 0.4s ease; pointer-events: none;
    }
    #scanHint .corner { position: absolute; width: 30px; height: 30px; border: 2px solid var(--gold); opacity: 0.85; }
    #scanHint .tl { top: 0; left: 0; border-right: none; border-bottom: none; border-radius: 6px 0 0 0; }
    #scanHint .tr { top: 0; right: 0; border-left: none; border-bottom: none; border-radius: 0 6px 0 0; }
    #scanHint .bl { bottom: 0; left: 0; border-right: none; border-top: none; border-radius: 0 0 0 6px; }
    #scanHint .br { bottom: 0; right: 0; border-left: none; border-top: none; border-radius: 0 0 6px 0; }
    #scanHint .scanline {
      position: absolute; left: 4px; right: 4px; height: 1.5px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
      box-shadow: 0 0 8px var(--gold); animation: scanMove 2.2s ease-in-out infinite;
    }
    @keyframes scanMove { 0% { top: 6%; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { top: 92%; opacity: 0; } }
    #scanHint p {
      position: absolute; bottom: -36px; width: 100%; text-align: center;
      font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: rgba(245,239,230,0.85);
      text-shadow: 0 2px 8px rgba(0,0,0,0.8);
    }
    body.found #scanHint, body.found #brandMark { opacity: 0; }

    /* Custom tracking-lost soft hint */
    #lostHint {
      position: fixed; top: calc(50% + min(32vw, 130px) + 46px); left: 50%;
      transform: translateX(-50%) translateY(8px); z-index: 450;
      padding: 8px 16px; border-radius: 999px; background: rgba(26,15,10,0.84);
      border: 1px solid rgba(212,175,55,0.45); color: #F0D687;
      font-size: 11px; letter-spacing: 1px; white-space: nowrap;
      opacity: 0; pointer-events: none; transition: opacity 0.4s ease, transform 0.4s ease;
    }
    #lostHint.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    body.found #lostHint, body.catalog-open #lostHint { opacity: 0 !important; }

    /* AR Tap-to-reveal Info Bubble */
    #arInfoBubble {
      position: fixed; top: max(70px, calc(env(safe-area-inset-top) + 56px)); left: 50%;
      transform: translateX(-50%) translateY(-10px) scale(0.95); z-index: 950;
      width: min(88vw, 320px); padding: 14px 16px; border-radius: 16px;
      background: rgba(26,15,10,0.92); border: 1px solid var(--gold);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      color: #F5EFE6; box-shadow: 0 14px 34px rgba(0,0,0,0.55);
      opacity: 0; pointer-events: none; transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.22,1,0.36,1);
    }
    #arInfoBubble.show { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0) scale(1); }
    #arInfoBubble h4 { margin: 0 0 4px; font-family: 'Cormorant Garamond', serif; font-size: 20px; color: #F0D687; }
    #arInfoBubble p { margin: 0 0 10px; font-size: 12px; line-height: 1.5; color: rgba(245,239,230,0.8); }
    #arInfoBubble .bubble-actions { display: flex; gap: 8px; }
    #arInfoBubble .bubble-btn {
      padding: 7px 14px; border-radius: 999px; border: none; font-size: 11px; font-weight: 700;
      letter-spacing: 1px; text-transform: uppercase; cursor: pointer;
    }
    #arInfoBubble .bubble-btn.primary { background: linear-gradient(135deg, var(--gold), var(--gold-soft)); color: #1a0f0a; }
    #arInfoBubble .bubble-btn.ghost { background: transparent; border: 1px solid rgba(212,175,55,0.4); color: #F5EFE6; }

    /* ---------- Buttons & Play Progress Ring ---------- */
    .plan-button {
      position: relative; overflow: hidden; padding: 13px 24px;
      font-family: 'Manrope', 'Noto Sans Tamil', sans-serif; font-size: 13px; font-weight: 700;
      letter-spacing: 1.2px; text-transform: uppercase;
      border: 1px solid rgba(212,175,55,0.4); border-radius: 999px;
      background: linear-gradient(135deg, var(--brand-accent) 0%, var(--brand-accent-dark) 100%);
      color: #F5EFE6; cursor: pointer; box-shadow: 0 8px 24px rgba(0,0,0,0.45);
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      transition: transform 0.15s ease, opacity 0.4s ease; white-space: nowrap;
    }
    .plan-button:active { transform: scale(0.96); }

    #openCatalogBtn {
      position: fixed; bottom: max(25px, env(safe-area-inset-bottom)); left: 20px; z-index: 1000;
      background: rgba(26, 15, 10, 0.85); border: 1px solid var(--gold); color: #F0D687;
      display: flex; align-items: center; gap: 8px;
    }
    body.catalog-open #openCatalogBtn { opacity: 0; pointer-events: none; }

    .video-panel {
      position: fixed; bottom: max(22px, env(safe-area-inset-bottom)); right: 20px;
      transform: translateY(16px); display: flex; align-items: center; gap: 10px;
      opacity: 0; z-index: 1000;
      transition: opacity 0.45s ease, transform 0.45s ease; pointer-events: none;
    }
    body.found .video-panel { opacity: 1; transform: translateY(0); pointer-events: auto; }
    body.catalog-open .video-panel { opacity: 0; pointer-events: none; }

    .play-ring-wrap {
      position: relative; width: 62px; height: 62px; display: grid; place-items: center;
    }
    .play-ring-svg {
      position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); pointer-events: none;
    }
    .play-ring-bg { fill: none; stroke: rgba(212,175,55,0.22); stroke-width: 3; }
    .play-ring-fg {
      fill: none; stroke: var(--gold); stroke-width: 3; stroke-linecap: round;
      stroke-dasharray: 175.9; stroke-dashoffset: 175.9; transition: stroke-dashoffset 0.15s linear;
    }
    #toggleButton {
      width: 50px; height: 50px; padding: 0; border-radius: 50%; display: grid; place-items: center;
      font-size: 18px; letter-spacing: 0;
    }

    /* Ripple */
    .btn-gold, .btn-ghost, .close-btn, .category-chip, .modal-close, .icon-pill { position: relative; overflow: hidden; }
    .ripple {
      position: absolute; border-radius: 50%; pointer-events: none; background: rgba(240,214,135,0.45);
      transform: scale(0); animation: ripple 0.6s ease-out forwards;
    }
    .btn-gold .ripple, .category-chip.active .ripple { background: rgba(26,15,10,0.25); }
    @keyframes ripple { to { transform: scale(1); opacity: 0; } }

    /* ---------- Chocolate Melt Drip Page Transition ---------- */
    #meltTransition {
      position: fixed; inset: 0; z-index: 2500; pointer-events: none;
      transform: translateY(-110%); transition: transform 0.72s cubic-bezier(0.65, 0, 0.35, 1);
    }
    #meltTransition.dripping { transform: translateY(0%); }
    #meltTransition.clearing { transform: translateY(110%); }
    #meltTransition svg { width: 100%; height: 120%; display: block; }

    /* ---------- First-Time Onboarding & Camera Permission Helper ---------- */
    .overlay-modal {
      position: fixed; inset: 0; z-index: 95000; display: flex; align-items: center; justify-content: center;
      padding: 20px; background: rgba(12,6,3,0.86); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      opacity: 0; pointer-events: none; transition: opacity 0.35s ease;
    }
    .overlay-modal.show { opacity: 1; pointer-events: auto; }
    .overlay-card {
      width: 100%; max-width: 380px; border-radius: 22px; padding: 28px 24px 24px;
      background: linear-gradient(180deg, #2a1810, #1a0f0a); border: 1px solid rgba(212,175,55,0.4);
      color: #F5EFE6; text-align: center; box-shadow: 0 24px 60px rgba(0,0,0,0.65);
    }
    .ob-slides { overflow: hidden; margin-bottom: 18px; }
    .ob-track { display: flex; transition: transform 0.4s cubic-bezier(0.22,1,0.36,1); }
    .ob-slide { min-width: 100%; padding: 6px 4px; }
    .ob-icon { font-size: 46px; margin-bottom: 10px; }
    .ob-slide h3 { margin: 0 0 8px; font-family: 'Cormorant Garamond', 'Noto Sans Tamil', serif; font-size: 26px; color: #F0D687; }
    .ob-slide p { margin: 0; font-size: 13px; line-height: 1.6; color: rgba(245,239,230,0.78); }
    .ob-dots { display: flex; justify-content: center; gap: 8px; margin-bottom: 18px; }
    .ob-dot { width: 8px; height: 8px; border-radius: 999px; background: rgba(245,239,230,0.28); transition: all 0.3s ease; }
    .ob-dot.active { width: 24px; background: var(--gold); }
    .ob-actions { display: flex; gap: 10px; justify-content: center; }

    /* =====================================================
       WEBSITE-STYLE CATALOG
    ===================================================== */
    #catalogStage { position: fixed; inset: 0; z-index: 2000; pointer-events: none; }

    #catalogSheet {
      position: absolute; inset: 0; height: 100dvh; width: 100vw;
      background:
        radial-gradient(ellipse at 15% -10%, rgba(107,58,31,0.38) 0%, transparent 50%),
        radial-gradient(ellipse at 100% 20%, rgba(212,175,55,0.12) 0%, transparent 45%),
        linear-gradient(180deg, var(--deep-2) 0%, var(--deep) 100%);
      overflow-y: auto; overflow-x: hidden; -webkit-overflow-scrolling: touch; scroll-behavior: smooth;
      transform: translateY(100%); opacity: 0;
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease;
      pointer-events: none;
    }
    #catalogSheet.open { transform: translateY(0); opacity: 1; pointer-events: auto; }
    #catalogSheet::-webkit-scrollbar { width: 8px; }
    #catalogSheet::-webkit-scrollbar-thumb { background: rgba(212,175,55,0.35); border-radius: 8px; }

    .container { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 20px; }

    /* Scroll reveal */
    .reveal { opacity: 0; transform: translateY(24px); }
    .reveal.in { opacity: 1; transform: none; transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.22, 1, 0.36, 1); }
    .reveal.done { transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; }

    /* Sticky Mini-Header Shrink */
    .site-nav {
      position: sticky; top: 0; z-index: 30; background: var(--nav-bg);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--glass-border); padding-top: env(safe-area-inset-top);
      transition: backdrop-filter 0.3s ease, box-shadow 0.3s ease;
    }
    .site-nav.scrolled {
      backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
      box-shadow: 0 8px 26px rgba(0,0,0,0.22);
    }
    .nav-inner { display: flex; align-items: center; gap: 10px; height: 64px; transition: height 0.28s ease; }
    .site-nav.scrolled .nav-inner { height: 52px; }
    .nav-logo {
      font-family: 'Cormorant Garamond', serif; font-weight: 700; font-size: 21px;
      letter-spacing: 3.5px; color: var(--gold-soft); display: flex; align-items: center; gap: 8px; white-space: nowrap;
      transition: font-size 0.28s ease;
    }
    .site-nav.scrolled .nav-logo { font-size: 18px; }
    .nav-logo::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 10px var(--gold); }
    .nav-links { display: none; gap: 22px; margin-left: 20px; }
    .nav-links a { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--cream-dim); text-decoration: none; cursor: pointer; transition: color .2s; }
    .nav-links a:hover { color: var(--gold-soft); }
    .nav-spacer { flex: 1; }

    .nav-controls { display: flex; align-items: center; gap: 6px; }
    .icon-pill {
      height: 34px; padding: 0 10px; border-radius: 999px; border: 1px solid var(--glass-border);
      background: var(--glass); color: var(--cream); font-size: 12px; font-weight: 600;
      cursor: pointer; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;
      transition: border-color 0.2s, background 0.2s;
    }
    .icon-pill:hover { border-color: var(--gold); }
    select.icon-pill { outline: none; padding-right: 6px; }
    select.icon-pill option { background: #2a1810; color: #F5EFE6; }

    .nav-search { position: relative; display: none; width: 230px; }
    .nav-search input, .mobile-search input {
      width: 100%; padding: 9px 14px 9px 36px; border-radius: 999px;
      border: 1px solid var(--glass-border); background: var(--glass);
      color: var(--cream); font-family: 'Manrope', 'Noto Sans Tamil', sans-serif; font-size: 13px; outline: none;
      transition: border-color .2s, background .2s;
    }
    .nav-search input:focus, .mobile-search input:focus { border-color: var(--gold); }
    .nav-search input::placeholder, .mobile-search input::placeholder { color: var(--cream-dim); }
    .search-icon { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); font-size: 13px; opacity: .7; pointer-events: none; }
    .close-btn {
      display: flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px;
      border: 1px solid var(--gold); background: transparent; color: var(--gold-soft);
      font-family: 'Manrope', sans-serif; font-size: 11px; font-weight: 700;
      letter-spacing: 1px; text-transform: uppercase; cursor: pointer;
      transition: background .2s, color .2s, transform .15s;
    }
    .close-btn:hover { background: var(--gold); color: var(--deep); }
    .close-btn span { display: none; }
    .mobile-search { position: relative; padding: 0 20px 10px; }
    .mobile-search .search-icon { left: 33px; top: calc(50% - 5px); }

    /* Search Suggestions Dropdown */
    .search-suggestions {
      position: absolute; left: 0; right: 0; top: calc(100% + 4px); z-index: 40;
      background: var(--glass-strong); border: 1px solid var(--glass-border); border-radius: 14px;
      backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      overflow: hidden; display: none; box-shadow: 0 14px 30px rgba(0,0,0,0.35);
    }
    .mobile-search .search-suggestions { left: 20px; right: 20px; top: calc(100% - 6px); }
    .search-suggestions.show { display: block; }
    .sugg-item {
      padding: 10px 14px; font-size: 13px; cursor: pointer; display: flex; justify-content: space-between;
      align-items: center; border-bottom: 1px solid rgba(212,175,55,0.12); color: var(--cream);
    }
    .sugg-item:last-child { border-bottom: none; }
    .sugg-item:hover { background: rgba(212,175,55,0.16); }
    .sugg-item small { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--gold); }
    mark.hl { background: rgba(212,175,55,0.35); color: inherit; border-radius: 3px; padding: 0 2px; }

    /* Parallax Hero */
    .hero { position: relative; padding: 48px 0 38px; text-align: center; overflow: hidden; }
    .hero::before {
      content: ""; position: absolute; left: 50%; top: -120px; width: 620px; height: 620px;
      transform: translateX(-50%); border-radius: 50%;
      background: radial-gradient(circle, rgba(107,58,31,0.45) 0%, transparent 65%); pointer-events: none;
    }
    .hero-parallax { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .p-shape {
      position: absolute; border-radius: 10px; border: 1px solid rgba(212,175,55,0.28);
      background: linear-gradient(135deg, rgba(107,58,31,0.32), rgba(212,175,55,0.12));
      will-change: transform;
    }
    .p-s1 { width: 54px; height: 54px; top: 14%; left: 8%; transform: rotate(18deg); }
    .p-s2 { width: 34px; height: 34px; top: 26%; right: 10%; border-radius: 50%; }
    .p-s3 { width: 42px; height: 42px; bottom: 18%; left: 16%; transform: rotate(-22deg); }
    .p-s4 { width: 64px; height: 64px; bottom: 10%; right: 14%; transform: rotate(32deg); }
    .hero > .container { position: relative; z-index: 2; }

    .greeting-pill {
      display: inline-block; padding: 5px 14px; border-radius: 999px; margin-bottom: 12px;
      background: var(--glass); border: 1px solid var(--glass-border);
      font-size: 11px; letter-spacing: 1.4px; color: var(--gold-soft);
    }
    .eyebrow { font-size: 11px; letter-spacing: 5px; text-transform: uppercase; color: var(--gold-soft); margin-bottom: 10px; }
    .hero h1 {
      font-family: 'Cormorant Garamond', 'Noto Sans Tamil', serif; font-weight: 600;
      font-size: clamp(36px, 8vw, 72px); line-height: 1.05; margin: 0 0 14px; letter-spacing: 1px;
      background: linear-gradient(100deg, var(--gold) 15%, var(--cream) 48%, var(--gold) 80%);
      background-size: 220% auto; background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    #catalogSheet.open .hero h1 { animation: titleShine 2.4s ease-out 0.4s 1; }
    @keyframes titleShine { 0% { background-position: 200% center; } 100% { background-position: 0% center; } }
    .hero p { max-width: 520px; margin: 0 auto 24px; color: var(--cream-dim); font-size: 15px; line-height: 1.7; }
    .hero-cta { display: inline-flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .btn-gold {
      padding: 12px 26px; border-radius: 999px; border: none; cursor: pointer;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%); color: #1a0f0a;
      font-family: 'Manrope', 'Noto Sans Tamil', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase;
      box-shadow: 0 10px 28px rgba(212,175,55,0.25); transition: transform .15s;
    }
    .btn-gold:active { transform: scale(0.96); }
    .btn-ghost {
      padding: 12px 24px; border-radius: 999px; cursor: pointer; background: transparent;
      border: 1px solid var(--glass-border); color: var(--cream);
      font-family: 'Manrope', 'Noto Sans Tamil', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase;
    }
    .hero-stats { display: flex; justify-content: center; gap: 36px; margin-top: 32px; flex-wrap: wrap; }
    .stat b { display: block; font-family: 'Cormorant Garamond', serif; font-size: 30px; color: var(--gold-soft); font-weight: 600; }
    .stat span { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--cream-dim); }

    /* Recently Viewed Row */
    #recentSection { display: none; margin: 8px 0 24px; }
    #recentSection.has-items { display: block; }
    .mini-row-head { font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; font-weight: 700; }
    .recent-row { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; }
    .recent-row::-webkit-scrollbar { display: none; }
    .recent-chip {
      flex: 0 0 auto; display: flex; align-items: center; gap: 10px; padding: 6px 12px 6px 6px;
      border-radius: 12px; background: var(--card-bg); border: 1px solid var(--glass-border);
      cursor: pointer; transition: border-color 0.2s; max-width: 210px;
    }
    .recent-chip:hover { border-color: var(--gold); }
    .recent-chip img { width: 42px; height: 42px; border-radius: 8px; object-fit: cover; }
    .recent-chip span { font-size: 12px; font-weight: 600; color: var(--cream); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-transform: capitalize; }

    .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 14px; flex-wrap: wrap; }
    .section-title { font-family: 'Cormorant Garamond', 'Noto Sans Tamil', serif; font-size: 30px; font-weight: 600; margin: 0; color: var(--cream); }
    .section-title small { display: block; font-family: 'Manrope', sans-serif; font-size: 10px; letter-spacing: 4px; text-transform: uppercase; color: var(--gold); margin-bottom: 4px; font-weight: 600; }

    /* Toolbar + Sliding Gold Pill */
    .toolbar {
      position: sticky; top: 52px; z-index: 20; padding: 10px 0;
      background: linear-gradient(180deg, var(--deep) 72%, transparent);
    }
    .toolbar-inner { display: flex; align-items: center; gap: 10px; justify-content: space-between; }
    .category-scroll {
      position: relative; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 3px 2px;
    }
    .category-scroll::-webkit-scrollbar { display: none; }
    .chip-slider {
      position: absolute; top: 3px; bottom: 3px; left: 0; width: 0; border-radius: 999px;
      background: var(--gold); z-index: 0; pointer-events: none;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), width 0.35s cubic-bezier(0.22, 1, 0.36, 1), background 0.25s ease;
    }
    .chip-slider.fav-mode { background: var(--heart); }
    .category-chip {
      position: relative; z-index: 1; padding: 8px 16px; border-radius: 999px; background: var(--glass);
      border: 1px solid var(--glass-border); color: var(--cream); font-family: 'Manrope', 'Noto Sans Tamil', sans-serif;
      font-size: 12px; letter-spacing: 0.8px; white-space: nowrap; cursor: pointer; transition: color 0.25s ease, border-color 0.25s ease;
    }
    .category-chip .count { opacity: .65; margin-left: 6px; font-size: 11px; }
    .category-chip:hover { border-color: var(--gold); }
    .category-chip.active { background: transparent; color: #1a0f0a; border-color: transparent; font-weight: 700; }
    .category-chip.fav-chip.active { color: #fff; }

    .toolbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .sort-wrap { display: none; align-items: center; gap: 6px; font-size: 11px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--cream-dim); }
    .sort-wrap select {
      background: var(--glass); color: var(--cream); border: 1px solid var(--glass-border);
      border-radius: 999px; padding: 7px 12px; font-family: 'Manrope', sans-serif; font-size: 12px; outline: none;
    }
    .sort-wrap select option { background: #2a1810; color: #F5EFE6; }
    .result-line { font-size: 12px; color: var(--cream-dim); letter-spacing: 1px; margin: 4px 0 16px; }

    /* Product Grid + List View Toggle + Crossfade */
    .catalog-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; padding-bottom: 60px;
      transition: opacity 0.25s ease;
    }
    .catalog-grid.fading { opacity: 0.2; }
    .catalog-grid.list-view { grid-template-columns: 1fr !important; max-width: 720px; margin: 0 auto; }
    .catalog-grid.list-view .catalog-card { flex-direction: row; align-items: stretch; }
    .catalog-grid.list-view .thumb-wrap { width: 42%; max-width: 240px; aspect-ratio: 1; flex-shrink: 0; }
    .catalog-grid.list-view .card-body { justify-content: center; padding: 18px 20px; }
    .catalog-grid.list-view .card-body .name { font-size: 22px; }

    .catalog-card {
      position: relative; background: var(--card-bg); border: 1px solid rgba(212,175,55,0.22);
      border-radius: 16px; overflow: hidden; cursor: pointer; display: flex; flex-direction: column;
      transform-style: preserve-3d; will-change: transform;
    }
    .catalog-card.done:hover {
      border-color: var(--gold);
      box-shadow: 0 18px 40px rgba(0,0,0,0.35), 0 0 0 1px rgba(212,175,55,0.18);
    }
    .thumb-wrap { position: relative; width: 100%; aspect-ratio: 4/5; overflow: hidden; background: rgba(128,90,60,0.12); }
    .thumb-wrap img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      filter: blur(14px); transform: scale(1.08);
      transition: filter 0.55s ease, transform 0.65s ease;
    }
    .thumb-wrap img.loaded { filter: blur(0); transform: scale(1); }
    .catalog-card:hover .thumb-wrap img.loaded { transform: scale(1.07); }
    .badge {
      position: absolute; top: 10px; left: 10px; z-index: 2; padding: 4px 10px; border-radius: 999px;
      background: rgba(26,15,10,0.76); border: 1px solid rgba(212,175,55,0.35);
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
      font-size: 9px; letter-spacing: 1.4px; text-transform: uppercase; color: #F0D687;
      max-width: calc(100% - 60px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .badge.new {
      top: auto; bottom: 10px; background: linear-gradient(135deg, var(--gold), var(--gold-soft));
      color: #1a0f0a; border-color: var(--gold); font-weight: 800; animation: newGlow 2s ease-in-out infinite;
    }
    @keyframes newGlow { 0%, 100% { box-shadow: 0 0 0 rgba(212,175,55,0); } 50% { box-shadow: 0 0 14px rgba(212,175,55,0.8); } }

    .heart {
      position: absolute; top: 8px; right: 8px; z-index: 3; width: 34px; height: 34px; border-radius: 50%;
      border: 1px solid rgba(212,175,55,0.35); background: rgba(26,15,10,0.72); color: #F5EFE6;
      font-size: 16px; line-height: 1; cursor: pointer; padding: 0;
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); transition: color .2s, border-color .2s, transform .15s;
    }
    .heart.on { color: var(--heart); border-color: var(--heart); }
    .heart.pop { animation: heartPop 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
    @keyframes heartPop { 0% { transform: scale(1); } 35% { transform: scale(1.45); } 100% { transform: scale(1); } }
    .burst-p {
      position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; border-radius: 50%;
      background: var(--heart); pointer-events: none; animation: burst 0.6s ease-out forwards;
    }
    .burst-p:nth-child(odd) { background: var(--gold); }
    @keyframes burst {
      from { transform: translate(-50%, -50%) scale(1); opacity: 1; }
      to { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0); opacity: 0; }
    }

    .card-body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; }
    .card-body .name {
      font-family: 'Cormorant Garamond', 'Noto Sans Tamil', serif; font-size: 18px; font-weight: 600; color: var(--cream);
      line-height: 1.2; text-transform: capitalize; overflow: hidden; display: -webkit-box;
      -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    }
    .card-body .view { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); display: flex; align-items: center; gap: 6px; }
    .card-body .view::after { content: "→"; transition: transform .25s; }
    .catalog-card:hover .view::after { transform: translateX(5px); }

    .skeleton { pointer-events: none; }
    .skeleton .thumb-wrap, .skeleton .line {
      background: linear-gradient(90deg, rgba(160,120,80,0.08) 25%, rgba(212,175,55,0.16) 50%, rgba(160,120,80,0.08) 75%);
      background-size: 200% 100%; animation: shimmer 1.4s infinite;
    }
    .skeleton .line { height: 14px; border-radius: 6px; margin: 4px 0; }
    @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    /* Empty-State Animated Sad Chocolate Bar */
    .catalog-empty {
      grid-column: 1 / -1; text-align: center; color: var(--cream-dim); padding: 48px 16px;
      font-family: 'Cormorant Garamond', 'Noto Sans Tamil', serif; font-size: 20px; font-style: italic;
      display: flex; flex-direction: column; align-items: center; gap: 14px;
    }
    .sad-choco-svg { width: 96px; height: 96px; animation: sadBob 2.6s ease-in-out infinite; }
    @keyframes sadBob { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-6px) rotate(2deg); } }

    .promise { border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); padding: 28px 0; }
    .promise-grid { display: grid; grid-template-columns: 1fr; gap: 20px; text-align: center; }
    .promise-item .ic { font-size: 22px; margin-bottom: 6px; }
    .promise-item h4 { margin: 0 0 4px; font-family: 'Cormorant Garamond', 'Noto Sans Tamil', serif; font-size: 19px; color: var(--gold-soft); }
    .promise-item p { margin: 0; font-size: 12px; color: var(--cream-dim); line-height: 1.6; }

    .site-footer { padding: 44px 0 calc(40px + env(safe-area-inset-bottom)); text-align: center; background: rgba(0,0,0,0.14); }
    .site-footer .logo { font-family: 'Cormorant Garamond', serif; font-size: 26px; letter-spacing: 5px; color: var(--gold-soft); font-weight: 700; }
    .site-footer p { color: var(--cream-dim); font-size: 12px; letter-spacing: 1px; margin: 10px 0 0; }
    .footer-links { display: flex; justify-content: center; gap: 22px; margin: 18px 0; flex-wrap: wrap; }
    .footer-links a { color: var(--cream); font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none; cursor: pointer; opacity: .8; }
    .footer-links a:hover { color: var(--gold-soft); opacity: 1; }

    /* Back-to-top Button */
    #backToTop {
      position: fixed; right: 20px; bottom: max(24px, env(safe-area-inset-bottom)); z-index: 2200;
      width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--gold);
      background: var(--glass-strong); color: var(--gold-soft); font-size: 18px; cursor: pointer;
      display: grid; place-items: center; box-shadow: 0 8px 24px rgba(0,0,0,0.35);
      opacity: 0; transform: translateY(16px); pointer-events: none; transition: opacity 0.25s, transform 0.25s;
    }
    #backToTop.show { opacity: 1; transform: translateY(0); pointer-events: auto; }

    /* Product Modal + Gallery + Pinch Zoom + Related */
    #productModal {
      position: fixed; inset: 0; z-index: 3000; display: flex; align-items: center; justify-content: center;
      padding: 16px; background: var(--modal-backdrop); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      opacity: 0; pointer-events: none; transition: opacity .3s ease, background .2s ease;
    }
    #productModal.show { opacity: 1; pointer-events: auto; }
    .modal-card {
      width: 100%; max-width: 920px; max-height: 92dvh; overflow-y: auto;
      background: linear-gradient(180deg, var(--deep-2), var(--deep));
      border: 1px solid var(--glass-border); border-radius: 20px; position: relative;
      display: grid; grid-template-columns: 1fr; transform: translateY(30px) scale(0.97);
      transition: transform .4s cubic-bezier(0.22, 1, 0.36, 1); overscroll-behavior: contain;
    }
    #productModal.show .modal-card { transform: translateY(0) scale(1); }
    .grabber { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 10px 0 2px; }
    .grabber i { width: 42px; height: 4px; border-radius: 4px; background: var(--cream-dim); opacity: 0.4; }
    .grabber small { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--cream-dim); }
    .modal-img { position: relative; background: rgba(128,90,60,0.08); aspect-ratio: 1; overflow: hidden; touch-action: none; }
    .modal-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.15s ease-out; transform-origin: center; }
    .gallery-dots {
      position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 6px; padding: 5px 10px; border-radius: 999px; background: rgba(26,15,10,0.65);
    }
    .gallery-dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; }
    .gallery-dot.active { background: var(--gold); transform: scale(1.2); }
    .zoom-hint {
      position: absolute; top: 12px; left: 12px; padding: 4px 10px; border-radius: 999px;
      background: rgba(26,15,10,0.65); color: #F0D687; font-size: 10px; letter-spacing: 1px; pointer-events: none;
    }
    .modal-info { padding: 22px 22px 20px; display: flex; flex-direction: column; gap: 12px; justify-content: center; }
    .modal-info .cat { font-size: 10px; letter-spacing: 4px; text-transform: uppercase; color: var(--gold); }
    .modal-info h2 { margin: 0; font-family: 'Cormorant Garamond', 'Noto Sans Tamil', serif; font-size: 32px; font-weight: 600; text-transform: capitalize; line-height: 1.1; }
    .modal-info p { margin: 0; color: var(--cream-dim); font-size: 14px; line-height: 1.65; }
    .modal-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
    #modalFav.on { color: var(--heart); border-color: var(--heart); }
    .modal-close {
      position: absolute; top: 12px; right: 12px; z-index: 4; width: 38px; height: 38px; border-radius: 50%;
      border: 1px solid var(--glass-border); background: var(--glass-strong); color: var(--gold-soft); font-size: 18px; cursor: pointer;
    }

    /* Related Treats Row in Modal */
    .modal-related {
      grid-column: 1 / -1; padding: 16px 22px 22px; border-top: 1px solid var(--glass-border);
    }
    .related-strip { display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none; }
    .related-strip::-webkit-scrollbar { display: none; }
    .rel-card {
      flex: 0 0 112px; border-radius: 12px; overflow: hidden; border: 1px solid var(--glass-border);
      background: var(--card-bg); cursor: pointer; transition: border-color 0.2s;
    }
    .rel-card:hover { border-color: var(--gold); }
    .rel-card img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
    .rel-card span {
      display: block; padding: 6px 8px; font-size: 11px; color: var(--cream); text-transform: capitalize;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* Quick-View Long Press Overlay */
    #quickViewOverlay {
      position: fixed; inset: 0; z-index: 4500; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 12px; padding: 24px;
      background: rgba(12,6,3,0.88); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      opacity: 0; pointer-events: none; transition: opacity 0.22s ease;
    }
    #quickViewOverlay.show { opacity: 1; pointer-events: auto; }
    #quickViewOverlay img {
      max-width: min(86vw, 420px); max-height: 62dvh; border-radius: 18px;
      border: 1.5px solid var(--gold); box-shadow: 0 24px 60px rgba(0,0,0,0.6); object-fit: cover;
    }
    #quickViewOverlay .qv-title { font-family: 'Cormorant Garamond', serif; font-size: 24px; color: #F0D687; text-transform: capitalize; }
    #quickViewOverlay small { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: rgba(245,239,230,0.65); }

    /* Gold Sparkle Confetti Layer */
    #confettiLayer { position: fixed; inset: 0; z-index: 99990; pointer-events: none; overflow: hidden; }
    .sparkle-p {
      position: absolute; width: 8px; height: 8px; border-radius: 2px; pointer-events: none;
      animation: sparkleFly 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes sparkleFly {
      0% { transform: translate(0, 0) scale(1) rotate(0deg); opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)) scale(0.2) rotate(var(--rot)); opacity: 0; }
    }

    /* Upgraded Slide-in Toast with Icon */
    #toast {
      position: fixed; left: 50%; bottom: max(90px, calc(env(safe-area-inset-bottom) + 70px));
      transform: translateX(-50%) translateY(24px); z-index: 99998; padding: 10px 18px; border-radius: 999px;
      background: rgba(26, 15, 10, 0.94); border: 1px solid var(--gold); color: #F0D687;
      font-size: 12px; font-weight: 600; letter-spacing: 1.1px;
      display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 12px 30px rgba(0,0,0,0.45);
      opacity: 0; pointer-events: none; transition: opacity .25s ease, transform .3s cubic-bezier(0.22,1,0.36,1);
    }
    #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* Offline Fallback & PWA Banner */
    #offlineOverlay { z-index: 98000; }
    #pwaBanner {
      position: fixed; left: 50%; bottom: max(16px, env(safe-area-inset-bottom));
      transform: translateX(-50%) translateY(120%); z-index: 2300;
      width: min(92vw, 420px); padding: 12px 14px; border-radius: 16px;
      background: var(--glass-strong); border: 1px solid var(--gold);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      box-shadow: 0 14px 36px rgba(0,0,0,0.45); transition: transform 0.4s cubic-bezier(0.22,1,0.36,1);
    }
    #pwaBanner.show { transform: translateX(-50%) translateY(0); }
    #pwaBanner .pwa-txt { font-size: 12px; line-height: 1.4; color: var(--cream); }
    #pwaBanner .pwa-txt b { color: var(--gold-soft); display: block; font-size: 13px; }

    @media (min-width: 768px) {
      .nav-links, .sort-wrap { display: flex; }
      .nav-search { display: block; }
      .mobile-search { display: none; }
      .close-btn span { display: inline; }
      .catalog-grid { grid-template-columns: repeat(3, 1fr); gap: 22px; }
      .promise-grid { grid-template-columns: repeat(3, 1fr); }
      .hero { padding: 76px 0 54px; }
      .modal-card { grid-template-columns: 1fr 1fr; }
      .grabber { display: none; }
      .modal-img { aspect-ratio: auto; min-height: 440px; }
      .modal-info { padding: 36px 32px; }
    }
    @media (min-width: 1100px) { .catalog-grid { grid-template-columns: repeat(4, 1fr); } }

    [class^="mindar-ui"], [id^="mindar-ui"], .mindar-ui-overlay, .a-enter-vr, .a-enter-ar, .a-orientation-modal {
      display: none !important; visibility: hidden !important; opacity: 0 !important;
    }

    @media (prefers-reduced-motion: reduce) {
      #catalogSheet, .hero h1, .thumb-wrap img, .badge.new, .choco-fill::after, #meltTransition { animation: none !important; transition: opacity 0.3s ease !important; }
      .reveal { opacity: 1; transform: none; }
    }
  </style>
</head>

<body>

  <div id="confettiLayer"></div>
  <div id="toast" role="status" aria-live="polite"><span id="toastIcon">✨</span><span id="toastMsg"></span></div>

  <video id="rawCameraFeed" autoplay playsinline muted></video>

